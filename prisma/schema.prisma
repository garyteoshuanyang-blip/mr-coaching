generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String?  @unique
  hashedPassword String?
  clientSlug     String?  @unique
  role           String   @default("client")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignedPrograms Program[]       @relation("ProgramClient")
  workoutLogs      WorkoutLog[]
  bodyWeightLogs   BodyWeightLog[]

  @@map("users")
}

model Exercise {
  id          String   @id @default(cuid())
  name        String
  muscleGroup String
  equipment   String?
  description String?
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workoutExercises WorkoutExercise[]

  @@map("exercises")
}

model BodyWeightLog {
  id        String   @id @default(cuid())
  clientId  String
  weight    Float
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, date])
  @@map("body_weight_logs")
}

model Program {
  id          String    @id @default(cuid())
  name        String
  description String?
  clientId    String?
  status      String    @default("active")
  startDate   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client User?  @relation("ProgramClient", fields: [clientId], references: [id], onDelete: SetNull)
  weeks  Week[]

  @@index([clientId])
  @@map("programs")
}

model Week {
  id         String  @id @default(cuid())
  programId  String
  weekNumber Int
  name       String?

  program Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  days    WorkoutDay[]

  @@unique([programId, weekNumber])
  @@map("weeks")
}

model WorkoutDay {
  id       String @id @default(cuid())
  weekId   String
  dayName  String
  dayOrder Int

  week      Week              @relation(fields: [weekId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]
  groups    WorkoutGroup[]

  @@unique([weekId, dayOrder])
  @@map("workout_days")
}

/// A superset/circuit grouping of exercises within a single day.
/// Exercises with a null groupId are standalone and behave exactly as before.
model WorkoutGroup {
  id           String   @id @default(cuid())
  dayId        String
  label        String // "A", "B", "C" — derived from sortOrder, stored for convenience
  sortOrder    Int
  restAfterSec Int? // rest after completing one full round of the group
  createdAt    DateTime @default(now())

  day       WorkoutDay        @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]

  @@map("workout_groups")
}

model WorkoutExercise {
  id         String  @id @default(cuid())
  dayId      String
  exerciseId String
  groupId    String?
  sortOrder  Int
  sets       Int
  reps       String
  weight     String?
  restSec    Int?
  rpe        String?
  notes      String?

  day      WorkoutDay    @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise Exercise      @relation(fields: [exerciseId], references: [id])
  group    WorkoutGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  logs     WorkoutLog[]

  @@unique([dayId, exerciseId])
  @@map("workout_exercises")
}

model WorkoutLog {
  id                String   @id @default(cuid())
  clientId          String
  workoutExerciseId String
  date              DateTime @default(now())
  loggedSets        String?
  notes             String?
  completed         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client          User            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@unique([clientId, workoutExerciseId, date])
  @@index([clientId, date])
  @@map("workout_logs")
}
